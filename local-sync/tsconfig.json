{
  // 型チェック・ビルドの対象外ファイル
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    // 出力される JS の文法レベル
    "target": "ES2022",
    // Node.js の ESM・CommonJS 判定ルールを使う
    "module": "NodeNext",
    // `import` の解決方法を Node.js のルールに合わせる
    "moduleResolution": "NodeNext",
    
    // 主要な型チェックを有効にする
    "strict": true,
    // CommonJS 形式のライブラリでも `import` できるようにする
    "esModuleInterop": true,
    // `default export` が型上存在しない CommonJS モジュールでも `default import` を許可する
    "allowSyntheticDefaultImports": true,
    
    // `node_modules/` 内の `.d.ts` の型チェックを省略する
    "skipLibCheck": true,
    // `import` のファイル名の大文字・小文字の表記揺れを検出する
    "forceConsistentCasingInFileNames": true,
    
    "types": [
      "node"  // Node.js の型定義をグローバル型として読み込む
    ],
    
    // JS ファイルを生成せず型チェックのみ行う
    "noEmit": true,
    // ソースマップを出力しない
    "sourceMap": false,
    // 型定義ファイル `.d.ts` を生成しない
    "declaration": false,
    
    // 配列やオブジェクトに添字アクセスした時「存在しない可能性」を型に反映する
    "noUncheckedIndexedAccess": true,
    // Optional Property と `undefined` を明確に区別する
    "exactOptionalPropertyTypes": true
  }
}
